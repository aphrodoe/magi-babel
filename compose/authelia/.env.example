# Copy to secrets/authelia.env — or just run scripts/magi/65-authelia.sh,
# which generates all three as 64-char random strings and writes the file at
# 0600. They are secrets, not settings: losing the storage encryption key
# means losing the TOTP registrations stored in the database.
AUTHELIA_SESSION_SECRET=changeme
AUTHELIA_STORAGE_ENCRYPTION_KEY=changeme
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=changeme
