# One wildcard cert for *.lab.akhildhyani.me, proven over DNS-01 because the
# names resolve to a Tailscale address Let's Encrypt cannot reach.

*.lab.akhildhyani.me {
	tls {
		dns desec {
			token {env.DESEC_TOKEN}
		}

		# deSEC's secondary nameserver replicates ~60s behind its primary
		# (measured 2026-08-30: ns1 at 13s, ns2 at 71s). Let's Encrypt
		# validates from several vantage points and may ask either one, so
		# submitting the challenge immediately fails on ns2 with
		# "During secondary validation: No TXT record found".
		# Wait past the lag before asking LE to look.
		propagation_delay 150s
		propagation_timeout 10m
	}

	@grafana host grafana.lab.akhildhyani.me
	handle @grafana {
		reverse_proxy grafana:3000
	}

	# Authelia's own login UI. Must stay unauthenticated — it is the thing you
	# get redirected TO.
	@auth host auth.lab.akhildhyani.me
	handle @auth {
		reverse_proxy authelia:9091
	}

	# Prometheus has no auth of its own, which is why it is the first thing put
	# behind Authelia rather than the last.
	@prom host prom.lab.akhildhyani.me
	handle @prom {
		# Uptime Kuma probes /-/healthy every 60 s. Redirecting that to a login
		# page would make the monitor flap red forever, so it is exempt — the
		# endpoint returns one line and exposes nothing.
		@needsauth not path /-/healthy
		forward_auth @needsauth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy prometheus:9090
	}

	# Both of these keep their own logins rather than sitting behind Authelia.
	# AdGuard has real auth already and a second prompt buys nothing; Radicale
	# must stay on HTTP Basic because CalDAV clients (iOS, DAVx5) cannot follow
	# a forward-auth redirect — the same trap that breaks the Bitwarden apps.
	@dns host dns.lab.akhildhyani.me
	handle @dns {
		reverse_proxy adguardhome:3000
	}

	@dav host dav.lab.akhildhyani.me
	handle @dav {
		reverse_proxy radicale:5232
	}

	@status host status.lab.akhildhyani.me
	handle @status {
		reverse_proxy uptime-kuma:3001
	}

	# Anything under the wildcard with nothing behind it. Without this Caddy
	# would serve an empty 200 and you'd waste an hour wondering which layer
	# ate the request.
	handle {
		respond "MAGI: no service is mounted at {host}" 404
	}
}
